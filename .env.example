# Optional: where the price database lives (default: ./data/chase.db)
# CHASE_DB_PATH=

# Card Search is hidden by default. To enable it, you need a local Ollama server
# running the model below, then set the flag and restart the dev server.
# NEXT_PUBLIC_ENABLE_CARD_SEARCH=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
